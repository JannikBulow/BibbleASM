segment .module
version 1
name #1

; Indexing is in order of definitions, starting at 1 to leave implicit null constant at 0.
segment .constpool
string "Main"
string ".main"
string "Intrinsics"
string "printString"
module_info #3
function_info #5, #4

segment .function
name #2
flags 0x0000
registers 4
parameters 1
; r0 = args: String[]
; r1 = i: ulong
; r2 = arg: String
; r3 = temp variables
code
    load_imm r1, 0
    loop:
        arraylength r3, r0
        icmp r3, r1, r3
        jge r3, loop_end

        arrayget r2, r0, r1
        call r3, #6, r2
        inc r1, 1
        jmp loop
    loop_end:
    load_null r3
    return r3
endcode